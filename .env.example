# MongoDB
MONGODB_URI=mongodb://localhost:27017/microbusiness

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# OTP (mock for dev; use Twilio/AWS SNS in production)
OTP_EXPIRY_MINUTES=5
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# AWS S3 (optional)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# S3_BUCKET=microbusiness-uploads

# App
PORT=3000
NODE_ENV=development

# CORS: comma-separated list of allowed frontend origins (no trailing slash)
# Next.js dev/prod runs on 3001; 5173 kept for the old Vite app.
CORS_ORIGINS=http://localhost:3001,http://localhost:5173,http://localhost:3000

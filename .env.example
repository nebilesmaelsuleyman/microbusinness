# MongoDB
MONGODB_URI=mongodb+srv://nebiloo:nebiloo@cluster0.ramuxrb.mongodb.net/microbusiness?appName=Cluster0

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
# Recommended default: short-lived access token. Override with env var (e.g. '1h', '30m').
JWT_EXPIRES_IN=1h
REFRESH_EXPIRES_IN=30d
REFRESH_EXPIRES_DAYS=30

# OTP (mock for dev; use Twilio/AWS SNS in production)
OTP_EXPIRY_MINUTES=5
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# AWS S3 (optional)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# S3_BUCKET=microbusiness-uploads

# App
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:3001

# SMTP (optional) - if set, the server will send reset/verification emails.
# Example (SMTP provider):
# SMTP_HOST=smtp.mailtrap.io
# SMTP_USER=youruser
# SMTP_PASS=yourpass
# SMTP_FROM=no-reply@example.com
# SMTP_SECURE=false

# Password reset expiry in minutes
PASSWORD_RESET_EXPIRES_MIN=60

# CORS: comma-separated list of allowed frontend origins (no trailing slash)
# Next.js dev/prod runs on 3001; 5173 kept for the old Vite app.
CORS_ORIGINS=http://localhost:3001,http://localhost:5173,http://localhost:3000
